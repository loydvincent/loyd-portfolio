---
import '../styles/global.css';

const skills = [
  { name: 'JavaScript', level: 85, category: 'Language' },
  { name: 'React',       level: 75, category: 'Framework' },
  { name: 'TypeScript',  level: 65, category: 'Language' },
  { name: 'Node.js',     level: 70, category: 'Runtime' },
  { name: 'HTML & CSS',  level: 90, category: 'Markup' },
  { name: 'Python',      level: 60, category: 'Language' },
  { name: 'Git',         level: 80, category: 'Tool' },
  { name: 'Astro',       level: 55, category: 'Framework' },
];

const projects = [
  {
    id: '002',
    name: 'Project Name',
    description: 'Replace with your project description. What it does, what problem it solves, and what you built.',
    tags: ['React', 'Node.js', 'MongoDB'],
    github: 'https://github.com',
    live: 'https://example.com',
  },
  {
    id: '003',
    name: 'Project Name',
    description: 'Replace with your project description. What it does, what problem it solves, and what you built.',
    tags: ['TypeScript', 'React', 'Tailwind CSS'],
    github: 'https://github.com',
    live: null,
  },
  {
    id: '004',
    name: 'Project Name',
    description: 'Replace with your project description. What it does, what problem it solves, and what you built.',
    tags: ['Python', 'FastAPI'],
    github: 'https://github.com',
    live: null,
  },
];

const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Lloyd Burton — Junior Software Engineer Portfolio" />
  <title>Lloyd Burton — Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>

<body class="font-sans bg-stone-50 text-gray-900 antialiased">

  <!-- Pokédex red top stripe -->
  <div class="h-1 bg-red-600 fixed top-0 left-0 right-0 z-50"></div>

  <!-- Navigation -->
  <header class="fixed top-1 left-0 right-0 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100">
    <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
      <span class="font-mono text-sm font-medium text-red-600 tracking-widest">No. 001</span>
      <div class="hidden sm:flex items-center gap-8">
        <a href="#about"    class="text-sm text-gray-500 hover:text-gray-900 transition-colors">About</a>
        <a href="#skills"   class="text-sm text-gray-500 hover:text-gray-900 transition-colors">Skills</a>
        <a href="#projects" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">Projects</a>
        <a href="#contact"  class="text-sm text-gray-500 hover:text-gray-900 transition-colors">Contact</a>
      </div>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-6 pt-28 pb-24">

    <!-- ── Hero ─────────────────────────────────────── -->
    <section id="about" class="mb-20">
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

        <!-- Red bar — Pokédex body aesthetic -->
        <div class="bg-red-600 px-8 py-3 flex items-center justify-between">
          <span class="font-mono text-xs text-red-100 tracking-[0.2em]">ENTRY No. 001</span>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-white opacity-25"></span>
            <span class="w-2 h-2 rounded-full bg-white opacity-20"></span>
            <span class="w-2 h-2 rounded-full bg-white opacity-20"></span>
          </div>
        </div>

        <div class="p-8 md:p-12">
          <div class="flex flex-col md:flex-row md:items-start gap-10">

            <!-- Main info -->
            <div class="flex-1">
              <p class="font-mono text-xs text-gray-400 tracking-[0.2em] uppercase mb-3">Software Engineer</p>
              <h1 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-none mb-5">
                Lloyd Burton
              </h1>
              <p class="text-gray-500 text-base leading-relaxed mb-8 max-w-md">
                Junior software engineer focused on building clean, well-structured web
                applications. I care about the details and enjoy shipping things that
                actually work.
              </p>

              <!-- Type badges -->
              <div class="flex flex-wrap gap-2 mb-8">
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-amber-50 text-amber-700 border border-amber-200">JavaScript</span>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-sky-50   text-sky-700   border border-sky-200">React</span>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-blue-50  text-blue-700  border border-blue-200">TypeScript</span>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-green-50 text-green-700 border border-green-200">Node.js</span>
              </div>

              <!-- CTAs -->
              <div class="flex flex-wrap gap-3">
                <a href="#projects" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition-colors">
                  View Projects
                </a>
                <a href="#contact" class="px-5 py-2.5 text-gray-700 text-sm font-medium rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-colors">
                  Contact
                </a>
              </div>
            </div>

            <!-- Pokédex-style profile data panel -->
            <div class="md:w-48 shrink-0 bg-gray-50 rounded-xl border border-gray-100 p-5">
              <p class="font-mono text-[10px] text-gray-400 tracking-[0.2em] mb-4">PROFILE DATA</p>
              <dl class="space-y-4">
                <div>
                  <dt class="font-mono text-[10px] text-gray-400 mb-0.5">CATEGORY</dt>
                  <dd class="text-sm font-medium text-gray-800">Web Developer</dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] text-gray-400 mb-0.5">LEVEL</dt>
                  <dd class="text-sm font-medium text-gray-800">Junior</dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] text-gray-400 mb-0.5">STATUS</dt>
                  <dd class="flex items-center gap-1.5 text-sm font-medium text-green-600">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
                    Open to Work
                  </dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] text-gray-400 mb-0.5">ABILITY</dt>
                  <dd class="text-sm font-medium text-gray-800">Quick Learner</dd>
                </div>
              </dl>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Skills / Abilities ─────────────────────── -->
    <section id="skills" class="mb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-red-500">02</span>
        <div class="h-px bg-gray-200 w-6"></div>
        <h2 class="text-xl font-bold text-gray-900">Abilities</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {skills.map((skill) => (
          <div class="bg-white rounded-xl border border-gray-200 p-4 hover:border-gray-300 hover:shadow-sm transition-all">
            <p class="font-mono text-[10px] text-gray-400 tracking-widest uppercase mb-1.5">{skill.category}</p>
            <p class="text-sm font-semibold text-gray-900 mb-3">{skill.name}</p>
            <div class="h-1 bg-gray-100 rounded-full overflow-hidden">
              <div
                class="h-full bg-red-500 rounded-full skill-bar"
                style={`--bar-width: ${skill.level}%`}
              ></div>
            </div>
            <p class="font-mono text-[10px] text-gray-400 mt-1.5 text-right">{skill.level}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Projects / Entries ─────────────────────── -->
    <section id="projects" class="mb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-red-500">03</span>
        <div class="h-px bg-gray-200 w-6"></div>
        <h2 class="text-xl font-bold text-gray-900">Entries</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        {projects.map((project) => (
          <article class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:border-gray-300 hover:shadow-sm transition-all group">
            <div class="flex items-center justify-between px-6 py-3 border-b border-gray-100">
              <span class="font-mono text-xs font-medium text-red-600 tracking-wider">No. {project.id}</span>
              <div class="flex gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-gray-200 group-hover:bg-red-200 transition-colors"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-gray-200 group-hover:bg-red-200 transition-colors"></span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-gray-900 mb-2">{project.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed mb-4">{project.description}</p>
              <div class="flex flex-wrap gap-1.5 mb-5">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs font-medium rounded-md bg-gray-100 text-gray-600">{tag}</span>
                ))}
              </div>
              <div class="flex items-center gap-4">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-gray-900 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-gray-900 transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Contact ────────────────────────────────── -->
    <section id="contact">
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-red-500">04</span>
        <div class="h-px bg-gray-200 w-6"></div>
        <h2 class="text-xl font-bold text-gray-900">Contact</h2>
      </div>

      <div class="bg-white rounded-2xl border border-gray-200 p-8 md:p-12">
        <div class="max-w-lg">
          <p class="text-gray-500 text-base leading-relaxed mb-8">
            I'm looking for junior engineering roles and open to collaboration.
            If you have an opportunity, a project, or just want to connect — reach out.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:hello@lloydburton.dev"
              class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition-colors"
            >
              Send Email
            </a>
            <a
              href="https://github.com/lloydburton"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 text-gray-700 text-sm font-medium rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-colors"
            >
              GitHub
            </a>
            <a
              href="https://linkedin.com/in/lloydburton"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 text-gray-700 text-sm font-medium rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-colors"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-200 bg-white mt-8">
    <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
      <span class="font-mono text-xs text-gray-400">No. 001 — LLOYD BURTON</span>
      <span class="font-mono text-xs text-gray-400">{year}</span>
    </div>
  </footer>

</body>
</html>