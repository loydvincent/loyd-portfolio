---
import Layout from "../layouts/Layout.astro";

const skills = [
  { name: "JavaScript", abbr: "JS", color: "var(--yellow)" },
  { name: "TypeScript", abbr: "TS", color: "var(--blue)" },
  { name: "Astro", abbr: "AS", color: "var(--red)" },
  { name: "React", abbr: "RE", color: "var(--blue)" },
  { name: "Node.js", abbr: "ND", color: "var(--green)" },
  { name: "Git", abbr: "GIT", color: "var(--purple)" },
];

const projects = [
  {
    id: "001",
    title: "Project title one",
    description: "Short description of what it does and the problem it solves.",
    color: "#e8d7c3",
  },
  {
    id: "002",
    title: "Project title two",
    description: "Short description of what it does and the problem it solves.",
    color: "#cfe1d6",
  },
  {
    id: "003",
    title: "Project title three",
    description: "Short description of what it does and the problem it solves.",
    color: "#d6dcec",
  },
  {
    id: "004",
    title: "Project title four",
    description: "Short description of what it does and the problem it solves.",
    color: "#ecdce8",
  },
];

const certifications = [
  { label: "Certification one", color: "var(--blue)" },
  { label: "Certification two", color: "var(--purple)" },
  { label: "Certification three", color: "var(--yellow)" },
];
---

<Layout>
  <main class="device">

    <!-- HEADER BAR -->
    <div class="header-bar">
      <div class="header-left">
        <span class="ball-icon"></span>
        <div>
          <div class="header-name">LOYD</div>
          <div class="header-handle">@syrax</div>
        </div>
      </div>
      <div class="header-right">
        <span class="entry-number">001</span>
        <span class="status-dot"></span>
      </div>
    </div>

    <!-- PROFILE PANEL -->
    <section class="profile-panel">
      <div class="avatar">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fbfbfa" stroke-width="1.6">
          <circle cx="12" cy="8" r="3.4"></circle>
          <path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"></path>
        </svg>
      </div>

      <div>
        <h1 class="profile-name">Loyd</h1>
        <span class="profile-role">SOFTWARE ENGINEER</span>
        <ul class="profile-facts">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-7.5-7-12a7 7 0 1 1 14 0c0 4.5-7 12-7 12Z"></path><circle cx="12" cy="9" r="2.4"></circle></svg>
            Based remotely / open to relocate
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M3 8h18"></path></svg>
            Computer Science graduate
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.5-7-10a7 7 0 1 1 14 0c0 5.5-7 10-7 10Z"></path></svg>
            Enjoys building clean, scalable systems
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19V6a2 2 0 0 1 2-2h11l3 3v12"></path><path d="M8 8h8M8 12h8"></path></svg>
            Always learning something new
          </li>
        </ul>
      </div>

      <div class="behavior-box">
        <strong>BEHAVIOR</strong>
        Junior engineer who likes solving real problems and shipping things that work. Still early in the career — learning fast and building in public.
      </div>
    </section>

    <!-- SKILLS + EXPERIENCE -->
    <div class="grid-2">
      <div class="card">
        <div class="card-header">
          <span class="icon-dot"></span>
          <h2>SKILLS</h2>
        </div>
        <div class="skill-grid">
          {skills.map((s) => (
            <div class="skill-chip">
              <span class="skill-swatch" style={`background:${s.color}`}>{s.abbr}</span>
              {s.name}
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="icon-dot"></span>
          <h2>EXPERIENCE</h2>
        </div>
        <p class="exp-role">Junior Software Engineer</p>
        <div class="exp-meta">
          <span>Company name</span>
          <span>2024 — Present</span>
        </div>
        <ul class="exp-list">
          <li>Built and maintained features across the stack</li>
          <li>Worked with the team on code review and testing</li>
          <li>Picked up new tools and patterns on the job</li>
        </ul>
      </div>
    </div>

    <!-- PROJECTS -->
    <div class="card full-width">
      <div class="card-header">
        <span class="icon-dot"></span>
        <h2>PROJECTS</h2>
      </div>
      <div class="project-grid">
        {projects.map((p) => (
          <div class="project-card">
            <span class="project-num">{p.id}</span>
            <div class="creature" style={`background:${p.color}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="#2b2b2b" stroke-width="1.6">
                <circle cx="9" cy="11" r="1"></circle>
                <circle cx="15" cy="11" r="1"></circle>
                <path d="M8 15c1.2 1 2.8 1 4 0"></path>
                <path d="M12 4c4 0 7 3.2 7 7.2 0 4-3 7.8-7 7.8s-7-3.8-7-7.8C5 7.2 8 4 12 4Z"></path>
              </svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            <a class="project-link" href="#">VIEW →</a>
          </div>
        ))}
      </div>
    </div>

    <!-- CERTIFICATIONS + TRAINER INFO -->
    <div class="grid-2">
      <div class="card">
        <div class="card-header">
          <span class="icon-dot"></span>
          <h2>CERTIFICATIONS</h2>
        </div>
        <div class="cert-grid">
          {certifications.map((c) => (
            <div class="cert">
              <div class="gem" style={`background:${c.color}`}></div>
              <div class="cert-label">{c.label}</div>
            </div>
          ))}
        </div>
        <div class="more-dots">
          <span></span><span></span><span></span>
          <em>more coming soon</em>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="icon-dot"></span>
          <h2>TRAINER INFO</h2>
        </div>
        <div class="trainer-list">
          <div class="trainer-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
            <div>
              <span class="trainer-label">EMAIL</span>
              <a href="mailto:you@example.com">you@example.com</a>
            </div>
          </div>
          <div class="trainer-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-7.5-7-12a7 7 0 1 1 14 0c0 4.5-7 12-7 12Z"></path><circle cx="12" cy="9" r="2.4"></circle></svg>
            <div>
              <span class="trainer-label">LOCATION</span>
              <span>Remote / open to relocate</span>
            </div>
          </div>
          <div class="trainer-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8M12 8v8"></path></svg>
            <div>
              <span class="trainer-label">GITHUB</span>
              <a href="https://github.com/syrax" target="_blank" rel="noopener">github.com/syrax</a>
            </div>
          </div>
          <div class="trainer-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 11v5M8 8v.01M12 16v-3.2c0-1.1.9-1.8 2-1.8s2 .7 2 1.8V16"></path></svg>
            <div>
              <span class="trainer-label">LINKEDIN</span>
              <a href="https://linkedin.com/in/your-handle" target="_blank" rel="noopener">linkedin.com/in/your-handle</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER BAR -->
    <div class="footer-bar">
      <a class="nav-btn" href="#top" aria-label="Back to top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
      </a>
      <span>THANKS FOR VISITING!</span>
      <a class="nav-btn" href="#top" aria-label="Back to top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
      </a>
    </div>

  </main>
</Layout>